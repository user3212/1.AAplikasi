<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Colorful Outline Circle -->
    <path
        android:pathData="M54,20A34,34 0,1,1 54,88A34,34 0,1,1 54,20M54,26A28,28 0,1,0 54,82A28,28 0,1,0 54,26Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:offset="0" android:color="#10B981" />
                <item android:offset="0.5" android:color="#3B82F6" />
                <item android:offset="1" android:color="#8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inside Icon (Open Book and Crescent Moon) -->
    
    <!-- Open Book Left Page -->
    <path
        android:pathData="M 54,72 L 54,54 Q 45,50 34,54 L 34,70 Q 45,66 54,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="54"
                android:endX="54"
                android:endY="72"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFF" />
                <item android:offset="1" android:color="#CBD5E1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Open Book Right Page -->
    <path
        android:pathData="M 54,72 L 54,54 Q 63,50 74,54 L 74,70 Q 63,66 54,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="54"
                android:endX="74"
                android:endY="72"
                android:type="linear">
                <item android:offset="0" android:color="#F8FAFC" />
                <item android:offset="1" android:color="#94A3B8" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Book Cover left -->
    <path
        android:pathData="M 34,70 L 34,73 Q 45,69 54,75 L 54,72 Q 45,66 34,70 Z"
        android:fillColor="#8B5CF6"/>
    <!-- Book Cover right -->
    <path
        android:pathData="M 74,70 L 74,73 Q 63,69 54,75 L 54,72 Q 63,66 74,70 Z"
        android:fillColor="#3B82F6"/>

    <!-- Crescent Moon -->
    <path
        android:pathData="M 54,34 A 12,12 0,1,1 42,46 A 14,14 0,1,0 54,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="34"
                android:endX="66"
                android:endY="58"
                android:type="linear">
                <item android:offset="0" android:color="#FBBF24" />
                <item android:offset="1" android:color="#D97706" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Star -->
    <path
        android:pathData="M 58,40 L 59.5,43 L 63,43.5 L 60.5,46 L 61,49.5 L 58,48 L 55,49.5 L 55.5,46 L 53,43.5 L 56.5,43 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="53"
                android:startY="40"
                android:endX="63"
                android:endY="49.5"
                android:type="linear">
                <item android:offset="0" android:color="#FDE047" />
                <item android:offset="1" android:color="#F59E0B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
